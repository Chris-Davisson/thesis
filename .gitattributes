# Normalize all text files to LF in the repo, convert on checkout per OS
* text=auto

# Shell scripts must stay LF (breaks on Linux/Docker with CRLF)
*.sh text eol=lf

# PowerShell scripts use CRLF on Windows
*.ps1 text eol=crlf

# Explicitly text files
*.py text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf

# Binary files — no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.xlsx binary
*.pdf binary
